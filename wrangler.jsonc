{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fantasy-arena-wiki",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "fantasyarena.wiki/*",
      "zone_name": "fantasyarena.wiki"
    },
    {
      "pattern": "www.fantasyarena.wiki/*",
      "zone_name": "fantasyarena.wiki"
    }
  ]
}
